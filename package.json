{
  "name": "buergertest-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ensure:rollup-native": "node scripts/ensure-rollup-native.mjs",
    "dev": "npm run ensure:rollup-native && vite",
    "build": "npm run ensure:rollup-native && tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "pipeline": "tsc -p tsconfig.pipeline.json && node dist/index.js",
    "pipeline:test": "tsc -p tsconfig.pipeline.json && node dist/test.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gh-pages": "^6.3.0",
    "lucide": "^1.11.0",
    "puppeteer": "^24.42.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "daisyui": "^5.5.19",
    "openai": "^6.34.0"
  }
}
